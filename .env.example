# Copy to .env and adjust before running docker-compose.prod.yml

# Host path ของ workspace (Linux VPS). ต้องเป็น path เดียวกันทั้ง Host และ Container
STRATUS_WORKSPACE_HOST_PATH=/var/lib/stratus/workspace

# URL ที่ Browser ของผู้ใช้เรียกถึง API (ฝังตอน build ของ web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Exact dashboard origin, no trailing slash. HTTPS enables Secure auth cookies.
DASHBOARD_ORIGIN=http://localhost:3000

# GitHub webhook secret (ต้องตรงกับที่ตั้งใน GitHub repo settings). ว่าง = ปิดรับ webhook
GITHUB_WEBHOOK_SECRET=

# Optional per-project npm download cache for automatic builds
STRATUS_NPM_CACHE=0

# Optional per-project pnpm download cache for automatic builds
STRATUS_PNPM_CACHE=0

# Maximum CPU cores per build container (1 or 2)
STRATUS_BUILD_CPU_CORES=1

# (ไม่บังคับ) Token สำหรับส่ง commit status กลับ GitHub
GITHUB_TOKEN=
