# Copy to .env and adjust before running docker-compose.prod.yml

# Host path ของ workspace (Linux VPS). ต้องเป็น path เดียวกันทั้ง Host และ Container
STRATUS_WORKSPACE_HOST_PATH=/var/lib/stratus/workspace

# URL ที่ Browser ของผู้ใช้เรียกถึง API (ฝังตอน build ของ web)
NEXT_PUBLIC_API_URL=http://localhost:4000
